          "spec",
          "containers",
          "*",
          "resources",
          "requests",
          "cpu"
        ],
        "control": "exact Kubernetes quantity",
        "label": "requests cpu {index}"
      },
      {
        "path": [
          "spec",
          "template",
          "spec",
          "containers",
          "*",
          "resources",
          "requests",
          "memory"
        ],
        "control": "exact Kubernetes quantity",
        "label": "requests memory {index}"
      },
      {
        "path": [
          "spec",
          "template",
          "spec",
          "containers",
          "*",
          "resources",
          "requests",
          "ephemeral-storage"
        ],
        "control": "exact Kubernetes quantity",
        "label": "requests ephemeral-storage {index}"
      },
      {
        "path": [
          "spec",
          "template",
          "spec",
          "containers",
          "*",
          "resources",
          "limits",
          "cpu"
        ],
        "control": "exact Kubernetes quantity",
        "label": "limits cpu {index}"
      },
      {
        "path": [
          "spec",
          "template",
