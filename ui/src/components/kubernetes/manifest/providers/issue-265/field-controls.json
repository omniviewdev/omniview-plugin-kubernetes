    "Endpoints": [
      {
        "path": [
          "subsets",
          "*",
          "addresses",
          "*",
          "ip"
        ],
        "control": "required unicast IP with local validation",
        "label": "Ready IP {index}",
        "conditional": "Live same-name Service must report selector none; controller ownership locks edits."
      },
      {
        "path": [
          "subsets",
          "*",
          "addresses",
          "*",
          "hostname"
        ],
        "control": "optional text",
        "label": "Hostname {index}",
        "conditional": "Live same-name Service must report selector none; controller ownership locks edits."
      },
      {
        "path": [
          "subsets",
          "*",
          "addresses",
          "*",
          "nodeName"
        ],
        "control": "optional text",
        "label": "Node name {index}",
        "conditional": "Live same-name Service must report selector none; controller ownership locks edits."
      },
      {
        "path": [
          "subsets",
          "*",
          "notReadyAddresses",
          "*",
          "ip"
        ],
        "control": "required unicast IP with local validation",
        "label": "Not-ready IP {index}",
        "conditional": "Live same-name Service must report selector none; controller ownership locks edits."
      },
