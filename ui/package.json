{
  "name": "omniview-plugin-kubernetes",
  "private": true,
  "version": "0.21.2",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build && node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test scripts/*.test.mjs scripts/eslint/*.test.mjs"
  },
  "dependencies": {
    "@omniviewdev/kit": "file:vendor/omniviewdev-kit-0.7.4.tgz",
    "@omniviewdev/runtime": "file:vendor/omniviewdev-runtime-0.7.4.tgz",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/react-query": "5.105.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react-dom": "19.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
